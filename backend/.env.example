# =====================================================
# NOVA Messenger - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =====================================================

# Application
APP_NAME="NOVA Messenger"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080
TRUST_PROXY=false
RATE_LIMIT_STORAGE_PATH=

# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nova
DB_USER=root
DB_PASSWORD=

# JWT / Token
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY_HOURS=720

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=/path/to/nova-messenger/backend/storage
STORAGE_URL=http://localhost:8000/storage

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# OTP (Development: use static OTP. Production: use real SMS provider)
OTP_PROVIDER=test
OTP_TEST_CODE=123456
# OTP_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# WebSocket / Realtime
WS_HOST=0.0.0.0
WS_PORT=8080
